# Names of the environment variables the services read. Placeholders only: pick your own values.
# Do NOT save real values in this file or in a committed .env (both are git-ignored / forbidden).

# Database (claims service). The dev password is defined in infra/docker-compose.yml.
SPRING_DATASOURCE_PASSWORD=<value from infra/docker-compose.yml>

# JWT (auth + gateway share it). At least 32 characters, e.g. generate with:
#   PowerShell: -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 48 | % {[char]$_})
#   bash:       openssl rand -base64 36
JWT_SECRET=<random, 32+ characters>

# Demo users (auth service)
AUTH_MEMBER_PASSWORD=<your choice>
AUTH_ADJUDICATOR_PASSWORD=<your choice>
AUTH_ADMIN_PASSWORD=<your choice>

# Optional
# SPRING_KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# GATEWAY_SECURITY_ENABLED=true          # false = no token needed (local demo only)
# CLAIMS_SERVICE_URI=http://127.0.0.1:8082
# AUTH_SERVICE_URI=http://127.0.0.1:8081